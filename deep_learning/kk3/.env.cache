# Cache configuration for wheeljack1 storage
# Source this file before running downloads: source .env.cache

export HF_HOME="/media/starscream/wheeljack1/.cache/huggingface"
export HF_DATASETS_CACHE="/media/starscream/wheeljack1/.cache/huggingface/datasets"
export TRANSFORMERS_CACHE="/media/starscream/wheeljack1/.cache/huggingface/transformers"
export TORCH_HOME="/media/starscream/wheeljack1/.cache/torch"
export UV_CACHE_DIR="/media/starscream/wheeljack1/.cache/uv"

echo "✓ Cache redirected to wheeljack1"
echo "  HF_HOME: $HF_HOME"
echo "  Free space: $(df -h /media/starscream/wheeljack1 | tail -1 | awk '{print $4}')"
